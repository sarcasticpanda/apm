{
  "name": "oauth-path",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-led OAuth setup guides and live provider research",
  "scripts": {
    "dev": "node server.mjs",
    "build": "node build.mjs",
    "test": "node --test backend.test.mjs tests/*.test.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:ui": "node tests/ui.mjs",
    "test:browsers": "node tests/cross-browser.mjs",
    "test:a11y": "node tests/a11y.mjs",
    "probe:endpoints": "node scripts/probe-authorize.mjs",
    "probe:research": "node scripts/research-probe.mjs",
    "setup:github": "node scripts/github-device-flow.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/puppeteer": "^1.4.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "playwright": "^1.64.1",
    "wrangler": "^4.157.0"
  }
}
