{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oauth-path",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
